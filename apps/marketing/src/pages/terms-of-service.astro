---
import LegalPage from "../components/LegalPage.astro";

const sections = [
  ["license", "Open-source license"],
  ["deployment", "Deployment responsibility"],
  ["upstream", "Upstream services"],
] as const;
---

<LegalPage
  title="Terms — Crab"
  description="License and deployment boundaries for Crab UI."
  heading="Crab Terms"
  lede="Crab UI is open-source software, not a hosted service offered by this repository."
  effectiveDate="2026-08-31"
  lastUpdated="2026-08-31"
  sections={sections}
>
  <section id="license">
    <p class="section-number">01</p>
    <h2>Open-source license</h2>
    <p>
      Use, copying, modification, and distribution of Crab UI are governed by the MIT license in the
      repository. The software is provided without warranties or guarantees, as described by that
      license.
    </p>
  </section>

  <section id="deployment">
    <p class="section-number">02</p>
    <h2>Deployment responsibility</h2>
    <p>
      Each operator is responsible for securing their deployment, choosing model and infrastructure
      providers, managing credentials, and reviewing agent commands and changes. Coding agents can
      produce incorrect or harmful output; the UI does not remove the need for operator judgment.
    </p>
  </section>

  <section id="upstream">
    <p class="section-number">03</p>
    <h2>Upstream services</h2>
    <p>
      Crab preserves compatibility with optional upstream services such as T3 Connect. Those are not
      Crab-operated services. If enabled, their separate provider terms and privacy policies apply.
    </p>
  </section>
</LegalPage>
