---
import LegalPage from "../components/LegalPage.astro";

const sections = [
  ["reporting", "Report a vulnerability"],
  ["scope", "Security boundary"],
  ["operator", "Operator responsibilities"],
] as const;
---

<LegalPage
  title="Security — Crab"
  description="Security reporting and deployment boundaries for Crab UI."
  heading="Crab Security"
  lede="Crab is powerful local agent software. Protect its UI, credentials, harness, workspace, and host as one security boundary."
  effectiveDate="2026-08-31"
  lastUpdated="2026-08-31"
  sections={sections}
>
  <section id="reporting">
    <p class="section-number">01</p>
    <h2>Report a vulnerability</h2>
    <p>
      Report fork-specific vulnerabilities privately through{" "}<a
        href="https://github.com/fontanierh/crab-ui/security/advisories/new">GitHub Security Advisories</a
      >. Do not include live credentials, private session content, or personal data.
    </p>
  </section>

  <section id="scope">
    <p class="section-number">02</p>
    <h2>Security boundary</h2>
    <p>
      Dropcliffs forwards only the authenticated web UI. The Crab kernel, ACP harness, model process,
      tools, workspace, credentials, and persistent state stay on the operator's machine. A UI session
      can still direct a highly privileged agent, so UI authentication is security-critical.
    </p>
  </section>

  <section id="operator">
    <p class="section-number">03</p>
    <h2>Operator responsibilities</h2>
    <p>
      Keep the fork and its dependencies current, restrict network exposure, protect credentials and
      pairing tokens, review provider permissions, and monitor the local supervisor and agent logs.
      Revoke credentials promptly if exposure is suspected.
    </p>
  </section>
</LegalPage>
